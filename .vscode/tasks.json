{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-std=c++17",
                "-g",
                "-I",
                "${workspaceFolder}/include",
                "${workspaceFolder}/src/FibonacciHeap.cpp",
                "${workspaceFolder}/tests/heap_tests.cpp",
                "-o",
                "${workspaceFolder}/heap_tests"
            ], 
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}